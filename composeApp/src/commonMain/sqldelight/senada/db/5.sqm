-- Versi 5 → 6: statistik dengar di perangkat, terpisah dari riwayat dan backup.
CREATE TABLE listen_event (
    id TEXT NOT NULL PRIMARY KEY,
    track_id TEXT NOT NULL,
    title TEXT NOT NULL,
    artists TEXT NOT NULL,
    duration_ms INTEGER,
    artwork_url TEXT,
    source TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    listened_ms INTEGER NOT NULL
);

CREATE INDEX listen_event_started_at ON listen_event(started_at);
